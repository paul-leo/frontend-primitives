{
  "name": "scope-context-vue",
  "version": "0.1.0",
  "description": "Vue bindings for scope-context: provideScope()/<ScopeProvider> thread a ScopeContext through the component tree (and apply its theme as CSS custom properties) without prop-drilling, plus useScope() and per-axis composables.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ../../scripts/write-dual-pkg.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul-leo/frontend-primitives.git",
    "directory": "packages/scope-context-vue"
  },
  "keywords": [
    "scope-context",
    "vue",
    "provide",
    "inject",
    "composables"
  ],
  "dependencies": {
    "scope-context": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.12"
  }
}
