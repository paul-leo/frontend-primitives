{
  "name": "scope-context-dexie",
  "version": "0.1.0",
  "description": "A scope-context storage adapter backed by Dexie.js — one independent IndexedDB database per scope, with the on('blocked')/on('versionchange') handling documented in the persistent-storage-with-dexie recipe wired in.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ../../scripts/write-dual-pkg.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul-leo/frontend-primitives.git",
    "directory": "packages/scope-context-dexie"
  },
  "keywords": [
    "scope-context",
    "dexie",
    "indexeddb",
    "storage"
  ],
  "dependencies": {
    "scope-context": "workspace:*",
    "scope-manager": "workspace:*"
  },
  "peerDependencies": {
    "dexie": ">=3.0.0"
  },
  "devDependencies": {
    "dexie": "^4.0.9",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
