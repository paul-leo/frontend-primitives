{
  "name": "scope-context-tanstack-query",
  "version": "0.1.0",
  "description": "A scope-context cache adapter backed by TanStack Query — one independent QueryClient per scope, so isolation is a separate object instance, not a shared client with prefixed keys.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ../../scripts/write-dual-pkg.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul-leo/frontend-primitives.git",
    "directory": "packages/scope-context-tanstack-query"
  },
  "keywords": [
    "scope-context",
    "tanstack-query",
    "cache"
  ],
  "dependencies": {
    "scope-context": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=5.0.0"
  },
  "devDependencies": {
    "@tanstack/query-core": "^5.59.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
